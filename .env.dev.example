APP_ENV=development
AWS_REGION=ap-northeast-2
S3_BUCKET=hymn-images-dev
DATABASE_URL=postgresql://appuser:devpass@db:5432/postgres
AUTH_SECRET=dev-only-secret
PASSWORD_RESET_ENABLED=true
EMAIL_SENDER=console
# churches.id of the church GET /scores shows a caller with no token. Empty,
# that route answers 503 to the app (the web sends a token and is unaffected).
ANONYMOUS_SCORES_CHURCH_ID=
