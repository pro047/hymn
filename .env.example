APP_ENV=production
AWS_REGION=ap-northeast-2
S3_BUCKET=hymn-images-dev
DATABASE_URL=postgresql://appuser:change-me@rds-endpoint:5432/postgres
AUTH_SECRET=change-me-to-long-random-secret
IMAGE=<account>.dkr.ecr.ap-northeast-2.amazonaws.com/hymn-dev-api:<tag>
# Password reset. Off until the frontend pages ship — the routes are not even
# mounted while this is false, so the three settings below are unused until it
# is flipped. When it IS flipped in production, all three are required: the app
# refuses to boot without them rather than mail credentials to a log or send a
# link nobody can open. See require_deliverable_transport in utils/email.py.
PASSWORD_RESET_ENABLED=false
EMAIL_SENDER=ses
SES_FROM_ADDRESS=no-reply@score-hymn.com
# Where the emailed link points. Left at its localhost default this produces a
# real, DKIM-signed mail whose only link goes to the recipient's own machine.
PASSWORD_RESET_URL_BASE=https://www.score-hymn.com/reset-password
